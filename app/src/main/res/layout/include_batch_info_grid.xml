<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Ligne 1 : Type + Stade -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Type" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvType" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stade actuel" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvCurrentStage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="?attr/colorPrimary"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Ligne 2 : Qté initiale + Qté actuelle -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_initial_quantity" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvInitialQuantity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_current_quantity" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvCurrentQuantity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Ligne 3 : Emplacement + Propriétaire -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_location" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_owner" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvOwner" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Ligne 4 : Licence + Taux de perte -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_license" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvLicense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/text_loss_percent" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvLossPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/compliance_orange"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Dates -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_start_date" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvStartDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_last_updated" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView android:id="@+id/tvLastUpdated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Expiration (conditionnelle) -->
    <TextView android:id="@+id/labelExpiration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_expiration" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone"/>
    <TextView android:id="@+id/tvExpirationDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/compliance_red" android:visibility="gone"/>

    <!-- Notes -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_notes" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/tvNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant"/>

</LinearLayout>
