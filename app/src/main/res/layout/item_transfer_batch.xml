<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView android:id="@+id/tvTaqninId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="?attr/colorPrimary"/>
        <TextView android:id="@+id/tvVariety" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
        <TextView android:id="@+id/tvStage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView android:id="@+id/tvQtyDeclared" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvQtyReceived" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:visibility="gone"/>
        <TextView android:id="@+id/tvDiscrepancy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
