<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème principal (mode clair) — Material Design 3 -->
    <style name="Theme.TaqninIDBatch" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Couleurs primaires -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>

        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="android:colorBackground">@color/md_theme_light_background</item>

        <!-- Erreurs -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>

        <!-- Style de la barre d'état -->
        <item name="android:statusBarColor">@color/taqnin_green_dark</item>
        <item name="android:navigationBarColor">@color/md_theme_light_surface</item>

        <!-- Coins arrondis globaux -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TaqninIDBatch.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TaqninIDBatch.Large</item>
    </style>

    <!-- Thème de lancement (splash screen) -->
    <style name="Theme.TaqninIDBatch.Launcher" parent="Theme.TaqninIDBatch">
        <item name="android:windowBackground">@color/taqnin_green_dark</item>
    </style>

    <!-- Formes -->
    <style name="ShapeAppearance.TaqninIDBatch.Medium" parent="ShapeAppearance.Material3.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.TaqninIDBatch.Large" parent="ShapeAppearance.Material3.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Style de la toolbar -->
    <style name="Widget.TaqninIDBatch.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/taqnin_green</item>
        <item name="titleTextColor">@color/md_theme_light_onPrimary</item>
    </style>

    <!-- Style des cartes -->
    <style name="Widget.TaqninIDBatch.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Badge de conformité -->
    <style name="Widget.TaqninIDBatch.ComplianceBadge">
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textColor">@color/surface_light</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
