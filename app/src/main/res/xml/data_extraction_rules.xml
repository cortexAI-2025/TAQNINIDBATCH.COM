<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune donnée de traçabilité ni de session ne quitte l'appareil par la
     sauvegarde cloud ou le transfert d'appareil : la base locale contient des
     données d'organisation et des saisies non envoyées. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
